{
  "uid": "nano-box-tracing",
  "title": "Nano Box — Request Tracing & Service Logs",
  "tags": ["nano-box", "loki", "tracing"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Loki Datasource",
        "type": "datasource",
        "query": "loki",
        "hide": 2
      },
      {
        "name": "correlation_id",
        "label": "Correlation ID (x-correlation-id)",
        "type": "textbox",
        "current": {
          "text": "",
          "value": ""
        },
        "query": ""
      },
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "allValue": "nano-box-(api-gateway|upload-service|backend|notification-service)",
        "query": "nano-box-api-gateway,nano-box-upload-service,nano-box-backend,nano-box-notification-service",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [
          { "text": "All", "value": "$__all", "selected": true },
          { "text": "nano-box-api-gateway", "value": "nano-box-api-gateway", "selected": false },
          { "text": "nano-box-upload-service", "value": "nano-box-upload-service", "selected": false },
          { "text": "nano-box-backend", "value": "nano-box-backend", "selected": false },
          { "text": "nano-box-notification-service", "value": "nano-box-notification-service", "selected": false }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 10,
      "title": "Total Requests",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service=~\"$service\"} | json | responseTime > 0 [$__range]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 11,
      "title": "Errors",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service=~\"$service\", level=\"error\"} [$__range]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 12,
      "title": "Warnings & Slow",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service=~\"$service\", level=\"warn\"} [$__range]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 13,
      "title": "P95 Latency",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {service=~\"$service\"} | json | unwrap responseTime [$__range])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 500 },
              { "color": "red", "value": 1000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 1,
      "title": "Traffic Volume by Service & Level",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, level) (count_over_time({service=~\"$service\"} [$__auto]))",
          "legendFormat": "{{service}} ({{level}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": { "mode": "normal" }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "P95 Response Time by Service (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {service=~\"$service\"} | json | unwrap responseTime [$__auto]) by (service)",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20,
            "showPoints": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Request Trace by Correlation ID (Gateway -> Upload / Backend)",
      "type": "logs",
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"$service\"} |~ \"$correlation_id\" | json | line_format \"[{{.service}}] {{.msg}} | reqId={{.reqId}} | ip={{.ip}}\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Ascending"
      }
    },
    {
      "id": 3,
      "title": "Recent Errors & Slow Requests",
      "type": "logs",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 23 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"$service\", level=~\"error|warn\"} |~ \"$correlation_id\" | json | line_format \"[{{.service}}] {{.msg}} | reqId={{.reqId}}\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
