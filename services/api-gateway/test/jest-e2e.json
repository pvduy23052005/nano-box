{
  "moduleFileExtensions": ["js", "mjs", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j|mj)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "allowJs": true
        }
      }
    ]
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(\\.pnpm/(http-proxy-middleware|httpxy|is-plain-obj)@|http-proxy-middleware|httpxy|is-plain-obj))"
  ]
}
